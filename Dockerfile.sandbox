# Multi-language hardened sandbox image for AI Coding Debugger
# Provides isolated execution for Python, JavaScript, TypeScript, Java, C, C++, and SQL
FROM debian:bookworm-slim

# Prevent interactive prompts during image build
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

# Install minimal compilers and runtimes for core languages
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-minimal \
    nodejs \
    default-jdk-headless \
    gcc \
    g++ \
    make \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged non-root sandbox user (UID 10001, GID 10001)
RUN groupadd -g 10001 sandboxgroup && \
    useradd -u 10001 -g sandboxgroup -m -s /bin/false sandboxuser

# Create workspace mount point owned by sandboxuser
RUN mkdir -p /workspace /app/code && \
    chown -R sandboxuser:sandboxgroup /workspace /app/code && \
    chmod 770 /workspace

# Run strictly as unprivileged user
USER 10001:10001
WORKDIR /workspace

# Non-executable default entrypoint
CMD ["echo", "AI Coding Debugger Sandbox Container"]
