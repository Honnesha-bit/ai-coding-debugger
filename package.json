{
  "name": "ai-coding-debugger",
  "version": "1.0.0",
  "description": "AI Coding Debugger with sandboxed execution, diff viewer, and guest usage limits",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:frontend": "vitest run",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:frontend",
    "evaluate": "node scripts/run_evaluation.js",
    "export": "node scripts/export_results.js"
  },
  "keywords": [
    "ai",
    "debugger",
    "sandbox",
    "code-analysis"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@monaco-editor/react": "^4.6.0",
    "axios": "^1.7.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "lucide-react": "^1.59.0",
    "monaco-editor": "^0.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
