# ==============================================================================
# AI Coding Debugger - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. Never commit your actual .env file or credentials to source control.
# 2. In production (NODE_ENV=production), strict container isolation is enforced.
#    Direct host execution is prohibited, and requests will fail closed if
#    Docker or Podman is not available.
# 3. For public deployment behind a reverse proxy (Cloudflare, Nginx, Render),
#    set TRUST_PROXY=true and restrict CORS_ORIGIN to your frontend domain.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Port the Express HTTP server listens on
PORT=3000

# Application environment: 'production', 'development', or 'test'
# When set to 'production':
# - SANDBOX_MODE is strictly locked to 'container' (fails closed if Docker missing)
# - OWASP HSTS headers are enabled
# - Detailed stack traces are suppressed in API responses
# - SESSION_SECRET must be at least 32 characters and cannot use default/template values
NODE_ENV=development

# High-entropy secret used for HMAC token signing and session verification.
# Generate in production using: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string_for_production

# ------------------------------------------------------------------------------
# 2. AI PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Active primary AI provider: 'mock', 'gemini', or 'openai'
# - 'mock': Local heuristic and pattern-matching provider (zero cost, zero keys required).
# - 'gemini': Google Gemini API. Requires GEMINI_API_KEY.
# - 'openai': OpenAI API. Requires OPENAI_API_KEY.
AI_PROVIDER=mock

# Secondary fallback AI provider: 'auto', 'openai', 'gemini', or 'none'
# When set to 'auto', falls back to OpenAI if Gemini fails, then to Mock.
AI_FALLBACK_PROVIDER=auto

# Hard cap on maximum total AI calls per request across retries and fallbacks
AI_MAX_CALLS_PER_REQUEST=3

# Google Gemini API key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (Required if AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Optional model override (Defaults: gemini-flash-latest for Gemini; gpt-4o-mini for OpenAI)
AI_MODEL=gemini-flash-latest

# Retry policy for transient network / 5xx provider failures
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=500
AI_TOTAL_TIMEOUT_MS=15000

# ------------------------------------------------------------------------------
# 3. GUEST ACCESS & RATE LIMITING
# ------------------------------------------------------------------------------
# Number of free debugging attempts granted to unauthenticated visitors
# Tracked concurrently across session cookie AND client IP
MAX_GUEST_USES=2

# Time window for sliding rate limiters in milliseconds (default 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum general API requests allowed per window per IP
RATE_LIMIT_MAX_REQUESTS=120

# Maximum heavy code analysis & execution requests per window per IP
RATE_LIMIT_DEBUG_MAX=20

# ------------------------------------------------------------------------------
# 4. SANDBOX SECURITY & EXECUTION SETTINGS
# ------------------------------------------------------------------------------
# Sandbox runner mode: 'container', 'host', or 'auto'
# - 'container': STRICT isolation mode. Requires Docker or Podman.
# - 'auto': Prefers container; falls back to host child process with honest status in development.
# NOTE: In production (NODE_ENV=production), this is automatically locked to 'container'.
SANDBOX_MODE=auto

# Docker image used for isolated container execution
SANDBOX_IMAGE=ai-coding-debugger-sandbox:latest

# Memory limit allocated to container (cgroups v2)
SANDBOX_MEMORY_LIMIT=256m

# Maximum process limit allocated to container (prevents fork bombs)
SANDBOX_PIDS_LIMIT=64

# CPU cores quota allocated to container
SANDBOX_CPUS=1.0

# Maximum execution duration in milliseconds before process/container is SIGKILLed (default 5000ms)
SANDBOX_TIMEOUT_MS=5000

# Maximum stdout/stderr output size before truncation (default 65536 bytes = 64KB)
MAX_OUTPUT_BYTES=65536

# Maximum concurrent code execution processes/containers allowed simultaneously
SANDBOX_MAX_CONCURRENT=4

# Maximum queue wait duration in milliseconds when concurrency limit is reached
SANDBOX_QUEUE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# SQLite database path.
# - In Docker / production, mount a persistent volume at /app/data to preserve user data.
# - Use ':memory:' for transient test execution.
DB_PATH=data/debugger.sqlite

# ------------------------------------------------------------------------------
# 6. PUBLIC ACCESS, REVERSE PROXY & CORS
# ------------------------------------------------------------------------------
# Set to 'true' if the app runs behind Cloudflare, Nginx, Render, or Railway reverse proxies.
# Enables Express trust proxy (1 hop) for accurate client IP rate limiting.
TRUST_PROXY=false

# Allowed CORS origins for browser API access.
# In production, set to your specific public domain (e.g., https://debugger.example.com).
# In development, '*' or true allows local origins.
CORS_ORIGIN=*
