# Dedicated Dockerfile for AI Coding Debugger Sandbox Executor Service
# Isolated internal microservice communicating with Docker daemon to run sandboxed containers.
FROM node:22-bookworm-slim AS runner

# Install Docker CLI client binary to communicate with the host Docker daemon socket
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3001 \
    SANDBOX_MODE=container \
    SANDBOX_IMAGE=ai-coding-debugger-sandbox:latest

# Copy manifests and install production-only runtime dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy backend source code
COPY src/ ./src/

# Prepare temporary directories for source code staging with host Docker daemon
RUN mkdir -p /app/temp && \
    chmod 777 /app/temp

EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3001) + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "src/executorServer.js"]
